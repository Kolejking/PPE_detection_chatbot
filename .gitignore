# ============================================================
# Input data
# ============================================================

inputs/images/*
inputs/videos/*

# Keep the directories in Git
!inputs/images/.gitkeep
!inputs/videos/.gitkeep

# ============================================================
# Generated outputs
# ============================================================

outputs/images/*
outputs/videos/*
outputs/logs/*

# Keep output directories in Git
!outputs/images/.gitkeep
!outputs/videos/.gitkeep
!outputs/logs/.gitkeep

